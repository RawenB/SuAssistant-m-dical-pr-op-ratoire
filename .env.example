# --- Local and free with Ollama (https://ollama.com): nothing leaves this computer ---
# ollama pull qwen3:8b      (or qwen3:14b for better answers, needs ~10 GB RAM)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:8b
OPENAI_REASONING_EFFORT=none

TEL_SERVICE=01 23 45 67 89
TEL_URGENCE=15

# Web app: HOST=0.0.0.0 to open it from a phone on the same Wi-Fi
# HOST=127.0.0.1
# PORT=5000
